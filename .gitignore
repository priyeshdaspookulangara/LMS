*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches

# Keystore files
# Uncomment the following lines if you want to ignore your keystore files.
# *.jks
# *.keystore

# External native build folder generated in Android Studio 2.2 and later
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control generated files
*.orig

# Crashlytics plugin
com_crashlytics_export_strings.xml

# Imported Modules
.idea/modules.xml
.idea/vcs.xml

# Editor-based Rest Client
httpRequests/

# Android Profiler captures
*.hprof

### Gradle ###
.gradle
build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper JAR file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignoring Gradle wrapper properties file (needed to run Gradle)
!gradle-wrapper.properties

# Cache files for Kotlin DSL
.gradle/kotlin-dsl/

# Ignore Buck generated folders
buck-out/
\.buckd/
*.buckconfig.local

# NDK files
.externalNativeBuild
android-ndk-*

# Misc
*.lock
*.DS_Store

