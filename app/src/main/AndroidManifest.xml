<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.ecommerceapp">

    <application
        android:name=".ECommerceApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Launcher Activity: Changed to ProductListActivity for now -->
        <activity
            android:name=".ui.product.ProductListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <!-- Keep it exported if you want to launch it directly for testing auth -->
            <!-- Or remove launcher intent filter if ProductList is the only entry point -->
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:parentActivityName=".ui.auth.LoginActivity" />

        <activity
            android:name=".MainActivity"
            android:label="@string/title_activity_main" />

        <activity
            android:name=".ui.product.ProductDetailActivity"
            android:parentActivityName=".ui.product.ProductListActivity" />
            <!-- Theme can be specified here if needed, e.g., for CollapsingToolbar -->
            <!-- android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" -->

        <activity
            android:name=".ui.cart.CartActivity"
            android:label="Shopping Cart"
            android:parentActivityName=".ui.product.ProductListActivity" />

        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:label="Checkout"
            android:parentActivityName=".ui.cart.CartActivity"
            android:windowSoftInputMode="adjustResize" />  <!-- Helps with keyboard covering fields -->

        <activity
            android:name=".ui.order.OrderHistoryActivity"
            android:label="My Orders"
            android:parentActivityName=".ui.product.ProductListActivity" />

        <activity
            android:name=".ui.order.OrderDetailActivity"
            android:label="Order Details"
            android:parentActivityName=".ui.order.OrderHistoryActivity" />

        <!-- Firebase Messaging Service -->
        <service
            android:name=".fcm.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- For Android 13 (API 33) and above, POST_NOTIFICATIONS permission is needed -->
    <!-- <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/> -->


</manifest>
