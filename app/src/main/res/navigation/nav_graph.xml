<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authCheckFragment">

    <fragment
        android:id="@+id/authCheckFragment"
        android:name="com.example.lmsapp.ui.auth.AuthCheckFragment"
        android:label="fragment_auth_check"
        tools:layout="@layout/fragment_auth_check" >
        <action
            android:id="@+id/action_authCheckFragment_to_loginRegisterFragment"
            app:destination="@id/loginRegisterFragment"
            app:popUpTo="@id/authCheckFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_authCheckFragment_to_courseListFragment"
            app:destination="@id/courseListFragment"
            app:popUpTo="@id/authCheckFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/loginRegisterFragment"
        android:name="com.example.lmsapp.ui.auth.LoginRegisterFragment"
        android:label="fragment_login_register"
        tools:layout="@layout/fragment_login_register" >
        <action
            android:id="@+id/action_loginRegisterFragment_to_courseListFragment"
            app:destination="@id/courseListFragment"
            app:popUpTo="@id/loginRegisterFragment"
            app:popUpToInclusive="true"/>
        <!-- Add action to a real login fragment later -->
         <action
            android:id="@+id/action_loginRegisterFragment_to_placeholderLoginFragment"
            app:destination="@id/placeholderLoginFragment" />
    </fragment>

    <fragment
        android:id="@+id/courseListFragment"
        android:name="com.example.lmsapp.ui.courses.CourseListFragment"
        android:label="fragment_course_list"
        tools:layout="@layout/fragment_course_list" >
        <argument
            android:name="isGuest"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <!-- Placeholder for actual login screen -->
    <fragment
        android:id="@+id/placeholderLoginFragment"
        android:name="com.example.lmsapp.ui.auth.PlaceholderLoginFragment"
        android:label="Placeholder Login"
        tools:layout="@layout/fragment_placeholder_login" />

</navigation>
